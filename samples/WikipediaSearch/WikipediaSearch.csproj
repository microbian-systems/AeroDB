<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AeroDB.WikipediaSearch</AssemblyName>
    <Description>AeroDB search demo — Wikipedia articles indexed with real ONNX embeddings across FTS, HNSW, MTREE, DiskANN, and hybrid search</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AeroDB/AeroDB.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="SurrealDb.Embedded.SurrealKv" VersionOverride="0.10.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="models\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
