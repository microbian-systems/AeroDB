<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AeroDB</RootNamespace>
    <Description>Experimental ML support for AeroDB — SurrealML model inference via SurrealQL ml:: functions. Requires SurrealDB compiled with the 'ml' feature.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>AeroDB.ML</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AeroDB.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AeroDB\AeroDB.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SurrealDb.Net" VersionOverride="0.10.2" />
  </ItemGroup>
</Project>
