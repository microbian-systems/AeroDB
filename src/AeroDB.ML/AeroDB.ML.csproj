<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AeroDB</RootNamespace>
    <Description>Experimental ML support for AeroDB — SurrealML model inference via SurrealQL ml:: functions. Requires SurrealDB compiled with the 'ml' feature.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>AeroDB.ML</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AeroDB.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AeroDB.Sable\AeroDB.Sable.csproj" />
    <ProjectReference Include="..\..\surrealdb.net\SurrealDb.Net\SurrealDb.Net.csproj" />
  </ItemGroup>
</Project>
