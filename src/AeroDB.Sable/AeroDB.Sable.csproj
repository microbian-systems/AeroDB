<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>.NET Transactional Document DB and Event Store on SurrealDB</Description>
    <PackageTags>surrealdb documentdb eventstore nosql</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      The source generator and diagnostics are part of the Sable consumer
      contract. ProjectReference makes them available while developing in this
      repository, but NuGet consumers only load compiler extensions from the
      analyzer asset folder.
    -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeAeroDBCompilerAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AeroDB.Tests" />
    <InternalsVisibleTo Include="AeroDB.AspNetIdentity" />
    <InternalsVisibleTo Include="AeroDB.ML" />
    <InternalsVisibleTo Include="AeroDB.Analyzers.Tests" />
    <InternalsVisibleTo Include="Dali.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AeroDB.SourceGenerators\AeroDB.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\AeroDB.Analyzers\AeroDB.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\surrealdb.net\SurrealDb.Net\SurrealDb.Net.csproj" />
    <ProjectReference Include="..\..\surrealdb.net\SurrealDb.Reactive\SurrealDb.Reactive.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dahomey.Cbor" />
    <PackageReference Include="FlakeId" VersionOverride="1.3.2" />
    <PackageReference Include="JasperFx.Events" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" VersionOverride="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" VersionOverride="10.0.9" />
  </ItemGroup>

  <!--
    Do not package Microsoft.CodeAnalysis*.dll here. Roslyn supplies those
    assemblies in the compiler host; shipping private copies can cause analyzer
    load/version conflicts. Both local projects target netstandard2.0 and have
    no other runtime dependency closure.
  -->
  <Target Name="IncludeAeroDBCompilerAssets">
    <ItemGroup>
      <TfmSpecificPackageFile
        Include="$(MSBuildProjectDirectory)\..\AeroDB.SourceGenerators\bin\$(Configuration)\netstandard2.0\AeroDB.SourceGenerators.dll"
        PackagePath="analyzers/dotnet/cs"
        BuildAction="None" />
      <TfmSpecificPackageFile
        Include="$(MSBuildProjectDirectory)\..\AeroDB.Analyzers\bin\$(Configuration)\netstandard2.0\AeroDB.Analyzers.dll"
        PackagePath="analyzers/dotnet/cs"
        BuildAction="None" />
    </ItemGroup>
  </Target>
</Project>
