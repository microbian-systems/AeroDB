<Project>
	<PropertyGroup>
		<!--
      Skip TargetFramework for MAUI projects — they self-define multi-targeted
      TargetFrameworks (net10.0-android, net10.0-ios, net10.0-maccatalyst, etc.)
      and setting this would clobber that.
    -->
		<TargetFramework
			Condition="'$(UseMaui)' != 'true' AND
                 '$(ManageTargetFrameworkIndependently)' != 'true' AND
                 '$(TargetFrameworks)' == ''">net10.0</TargetFramework>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup Label="Package information">
		<VersionPrefix>0.0.8.1</VersionPrefix>
		<VersionSuffix>alpha</VersionSuffix>
		<Authors>Microbians</Authors>
		<Company>Microbian Systems</Company>
		<Copyright>Copyright (c) 2026 Microbians</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>surrealdb document-database event-sourcing nosql orm efcore</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>aero-logo-new.png</PackageIcon>
		<PackageProjectUrl>https://microbians.io/products</PackageProjectUrl>
		<RepositoryUrl>https://github.com/microbian-systems/AeroDB</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!--
    Source Generator & Analyzer: Wire Aero.Cms.SourceGenerators to every project
    in src/ so ModuleManifestGenerator, WolverineHandlerGenerator, and AERO002 analyzer
    run where needed. Each generator activates only when its conditions are met:
    - ModuleManifestGenerator: activates when [Module] attribute is found
    - WolverineHandlerGenerator: activates when [WolverineHandler] attribute is found
    - HostModuleCatalogGenerator: activates when ModuleManifestProviderAttribute assembly
      attributes are detected on referenced assemblies (naturally only in Aero.Cms.Web)
  -->
	<!-- ItemGroup Condition="'$(MSBuildProjectName)' != 'Aero.Cms.SourceGenerators' AND '$(MSBuildProjectName)' != 'AeroDB.SourceGenerators' AND '$(MSBuildProjectName)' != 'AeroDB' AND '$(MSBuildProjectName)' != 'AeroDB.WolverineFx' AND '$(MSBuildProjectName)' != 'AeroDB.AspNetIdentity' AND '$(MSBuildProjectName)' != 'AeroDB.EntityFrameworkCore' AND '$(MSBuildProjectName)' != 'AeroDB.Tests'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Aero.Cms.SourceGenerators\Aero.Cms.SourceGenerators.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false" />
	</!-->

	<ItemGroup>
		<!-- Package icon and README: included explicitly so dotnet pack finds them -->
		<None Include="../../assets/aero-logo-new.png" Pack="true" PackagePath="/" Visible="false" />
		<None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
	</ItemGroup>
</Project>